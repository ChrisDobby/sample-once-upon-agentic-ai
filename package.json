{
  "name": "once-upon-agentic-ai",
  "version": "1.0.0",
  "description": "A comprehensive workshop for mastering AI agent development with LangChain.js",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ch1": "tsx 1_langchain_basics/simple_agent.ts",
    "ch2": "tsx 2_prebuilt_tools/agent_with_prebuilt_tools.ts",
    "ch2:bonus": "tsx 2_prebuilt_tools/bonus_quest.ts",
    "ch3": "tsx 3_custom_tools/agent_with_dice_roll_tool.ts",
    "ch4:server": "tsx 4_mcp_integration/dice_roll_mcp_server.ts",
    "ch4:client": "tsx 4_mcp_integration/gamemaster_mcp_client.ts",
    "ch5:chroma": "chroma run --path 5_subagents/utils/dnd_knowledge_base --port 8005",
    "ch5:kb": "cd 5_subagents/utils && tsx create_knowledge_base.ts",
    "ch5:gamemaster": "tsx 5_subagents/agents/gamemaster_orchestrator/gamemaster_orchestrator.ts",
    "ch7": "tsx 7_deep_agents/gamemaster_deep_agent.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.8",
    "@langchain/aws": "^1.4.6",
    "@langchain/core": "^1.2.16",
    "@langchain/langgraph": "^1.4.19",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/mcp-adapters": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "chromadb": "^3.5.0",
    "cors": "^2.8.5",
    "deepagents": "^1.14.2",
    "express": "^5.1.0",
    "langchain": "^1.5.15",
    "unpdf": "^1.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0"
  }
}
