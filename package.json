{
  "name": "once-upon-agentic-ai",
  "version": "1.0.0",
  "description": "A comprehensive workshop for mastering AI agent development with the Strands Agents TypeScript SDK",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ch1": "tsx 1_strands_basics/simple_agent.ts",
    "ch2": "tsx 2_vended_tools/agent_with_vended_tools.ts",
    "ch2:bonus": "tsx 2_vended_tools/bonus_quest.ts",
    "ch3": "tsx 3_custom_tools/agent_with_dice_roll_tool.ts",
    "ch4:server": "tsx 4_mcp_integration/dice_roll_mcp_server.ts",
    "ch4:client": "tsx 4_mcp_integration/gamemaster_mcp_client.ts",
    "ch5:chroma": "chroma run --path 5_a2a_integration/utils/dnd_knowledge_base --port 8005",
    "ch5:kb": "cd 5_a2a_integration/utils && tsx create_knowledge_base.ts",
    "ch5:rules": "tsx 5_a2a_integration/agents/rules_agent/rules_agent.ts",
    "ch5:character": "tsx 5_a2a_integration/agents/character_agent/character_agent.ts",
    "ch5:gamemaster": "tsx 5_a2a_integration/agents/gamemaster_orchestrator/gamemaster_orchestrator.ts",
    "ch7": "tsx 7_strands_harness/gamemaster_harness.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.10",
    "@chroma-core/default-embed": "^0.1.8",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@strands-agents/harness": "^0.1.1",
    "@strands-agents/sdk": "^1.19.0",
    "chromadb": "^3.5.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "unpdf": "^1.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0"
  }
}
